# ---- Server ----
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:4000

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=noir_cafe

# ---- Auth ----
# Generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=noirCAFE_12345678@2026
JWT_EXPIRES_IN=1d

# ---- Paystack (Ghana) ----
# Get test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Default admin (created by `npm run seed`) ----
ADMIN_EMAIL=hello@noircafe@gmail.com
ADMIN_PASSWORD=noircafe@2026
ADMIN_NAME=admin
